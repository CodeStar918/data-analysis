# 复制为 .env 后按需修改
APP_NAME=报表生成平台
ENV=dev
DATABASE_URL=sqlite:///./backend_dev.db
JWT_SECRET=change-me-in-production-please-use-32-bytes-min
JWT_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
DUCKDB_PATH=./data/report.duckdb
MAX_UPLOAD_MB=20
# Ollama 本地模型
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 异步任务：开发默认 eager 同步；生产设 false 并启动 celery worker
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=true
